MAKEFLAGS += --no-builtin-rules
.SUFFIXES:

ASMSH_FLAGS=-define=MATCHING=1 -debug -cpu=sh4 -endian=little -sjis
BUILD_DIR=build
OUTPUT_DIR=$(BUILD_DIR)/output_matching
SHA1_CHECKSUM=a6df9e0de39b2d11e9339aef915d20e35763ec81
SHELL := /bin/bash

SRCS = \
	src/asm/010000.src \
	src/010080_main.c \
	src/asm/decompiled/0100bc_sound.src \
	src/010e90.c \
	src/asm/decompiled/010fe8_heap.src \
	src/asm/decompiled/011120_asset_queues.src \
	src/asm/decompiled/012324_peripheral_support.src \
	src/asm/decompiled/012504_input.src \
	src/asm/decompiled/0129cc_pause.src \
	src/asm/decompiled/012f44_game.src \
	src/asm/decompiled/013ae8_route_load.src \
	src/014934.c \
	src/0149b0_sbinit.c \
	src/014a9c_tasks.c \
	src/014b8c_backup.c \
	src/asm/decompiled/014f54_text.src \
	src/asm/decompiled/015ab8_title.src \
	src/016108.c \
	src/asm/decompiled/01614c_debug_menu.src \
	src/asm/decompiled/016bf4_demo_input.src \
	src/asm/decompiled/016c58_prompt.src \
	src/asm/decompiled/016d2c_course_menu.src \
	src/asm/decompiled/018644_file_menu.src \
	src/asm/decompiled/0193c8_vm_menu.src \
	src/asm/decompiled/019e98_main_menu.src \
	src/asm/decompiled/01a148_option.src \
	src/asm/decompiled/01b19c_system_menu.src \
	src/asm/decompiled/01bb48_vm_game.src \
	src/asm/decompiled/01c980_profile_file.src \
	src/asm/decompiled/01d290_album.src \
	src/asm/decompiled/01d7fc_results.src \
	src/asm/decompiled/01e27c_practice_menu.src \
	src/asm/decompiled/01f3c0_ending.src \
	src/asm/decompiled/01fa78.src \
	src/asm/decompiled/020214_drive_cue_task.src \
	src/020528_drive_cue_init.c \
	src/asm/decompiled/020594_vehicle_model.src \
	src/asm/decompiled/0206f0_intersect.src \
	src/asm/decompiled/0207d4_vec_xz.src \
	src/asm/decompiled/02081c_geom.src \
	src/asm/decompiled/020914_ground_query.src \
	src/asm/decompiled/020b6c_ground_probe.src \
	src/asm/decompiled/02171c_tile_stream.src \
	src/asm/decompiled/021b9c_tile_draw.src \
	src/asm/decompiled/0222dc_fadecmd.src \
	src/asm/decompiled/022464_fade.src \
	src/asm/decompiled/022bdc_bus.src \
	src/asm/decompiled/023310_bus_init.src \
	src/asm/decompiled/023938_bus_drive.src \
	src/asm/decompiled/02412c_bus_line.src \
	src/asm/decompiled/024280_bus_input.src \
	src/asm/decompiled/024b4c_bus_render.src \
	src/asm/decompiled/025870_demo.src \
	src/asm/decompiled/025b98_traffic_drive.src \
	src/asm/decompiled/026710_traffic.src \
	src/asm/decompiled/02786c_vehicle_parts.src \
	src/asm/decompiled/027958_bus_draw.src \
	src/asm/decompiled/028258_objects.src \
	src/asm/decompiled/02af78_event.src \
	src/asm/decompiled/02b2f0_drive_msg.src \
	src/asm/decompiled/02b464_drive_points.src \
	src/asm/decompiled/02c884_bus_stop.src \
	src/asm/decompiled/02d06c_stop_draw.src \
	src/asm/decompiled/02d19c_passenger.src \
	src/asm/decompiled/02d968_stop_spawn.src \
	src/asm/decompiled/02df3c_traffic_lookahead.src \
	src/asm/decompiled/02e2dc_bus_collision.src \
	src/asm/decompiled/02e400_collision.src \
	src/asm/sectionB.src \
	src/asm/decompiled/02e51c_attr_query.src \
	src/asm/decompiled/02f0c8_traffic_path_scan.src \
	src/asm/decompiled/02f320_replay_codec.src \
	src/asm/sectionD.src \
	src/asm/04ce10_slots.src \
	src/asm/02fb50_sh4nlfzn.src \
	src/asm/03327c_strt1_sectionC.src \
	src/asm/04f6c0_SDK.src \
	src/02fb50_sh4nlfzn_post_data.c

OBJS = $(patsubst src/%.c,$(OUTPUT_DIR)/src/%.obj,$(SRCS))
OBJS := $(patsubst src/asm/%.src,$(OUTPUT_DIR)/src/asm/%.obj,$(OBJS))
OBJS := $(patsubst src/asm/decompiled/%.src,$(OUTPUT_DIR)/src/asm/decompiled/%.obj,$(OBJS))
LINKER_OBJS = $(subst /,\\, $(OBJS))

# A full build is a few seconds; make a stale-object mistake impossible by
# default. `make all` opts into the incremental build.
.DEFAULT_GOAL := rebuild

all: $(OUTPUT_DIR)/tbg.bin

# Compile ASM files
$(OUTPUT_DIR)/src/asm/%.obj: src/asm/%.src
	@mkdir -p $(@D)
	wibo "$(SHC_BIN)/asmsh.exe" "$(subst /,\\,$<)" -object="$(subst /,\\,$@)" $(ASMSH_FLAGS)

# Compile decompiled ASM files
$(OUTPUT_DIR)/src/asm/decompiled/%.obj: src/asm/decompiled/%.src
	@mkdir -p $(@D)
	wibo "$(SHC_BIN)/asmsh.exe" "$(subst /,\\,$<)" -object="$(subst /,\\,$@)" $(ASMSH_FLAGS)

# Compile C files
$(OUTPUT_DIR)/src/%.obj: src/%.c
	@mkdir -p $(@D)
	wibo "$(SHC_BIN)/shc.exe" "$(subst /,\\,$<)" -object="$(subst /,\\,$@)" -sub=$(BUILD_DIR)/shc_matching.sub

$(OUTPUT_DIR)/tbg.elf: $(OBJS) $(BUILD_DIR)/lnk_matching.sub
	wibo "$(SHC_BIN)/lnk.exe" -sub=build\\lnk_matching.sub

$(BUILD_DIR)/lnk_matching.sub: $(BUILD_DIR)/lnk_matching_template.sub
	sed 's|@INPUTS@|$(foreach obj,$(LINKER_OBJS),input $(obj)\n)|g' $(BUILD_DIR)/lnk_matching_template.sub > $(BUILD_DIR)/lnk_matching.sub

$(OUTPUT_DIR)/tbg.bin: $(OUTPUT_DIR)/tbg.elf
	wibo "$(KATANA_SDK_DIR)/bin/elf2bin.exe" -s 8c010000 "$(subst /,\\,$<)"
	@if ! echo "$(SHA1_CHECKSUM) *$(OUTPUT_DIR)/tbg.bin" | sha1sum --status -c -; then \
		echo "======================" ;\
		echo "Oops, build differs :/" ;\
		echo "======================" ;\
		exit 1 ;\
	fi
	@echo "=====================" ;\
	echo "Yay! Build matches :)" ;\
	echo "====================="

clean:
	rm -rf $(OUTPUT_DIR) $(BUILD_DIR)/lnk_matching.sub

rebuild: clean .WAIT all

.PHONY: all clean rebuild $(OUTPUT_DIR)/tbg.bin

include Makefile.d
