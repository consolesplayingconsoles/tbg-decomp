MAKEFLAGS += --no-builtin-rules
.SUFFIXES:

ASMSH_FLAGS=-define=UNIT_TESTING=1 -debug -cpu=sh4 -endian=little -sjis
BUILD_DIR=build
OUTPUT_DIR=$(BUILD_DIR)/output_test

SHELL := /bin/bash

# Every C unit gets a test object. A unit with an archived original gets an asm
# one too, so its group can run each case against both; a unit the matching
# build compiles from C has no such archive and is tested against the C alone.
ASM_SRCS = $(wildcard src/asm/decompiled/*.src)
C_SRCS = $(wildcard src/*.c)

C_OBJS = $(patsubst src/%.c,$(OUTPUT_DIR)/src/%.obj,$(C_SRCS))
ASM_OBJS = $(patsubst src/%.src,$(OUTPUT_DIR)/src/%.obj,$(ASM_SRCS))

# A full build is a few seconds; make a stale-object mistake impossible by
# default. `make all` opts into the incremental build.
.DEFAULT_GOAL := rebuild

all: $(ASM_OBJS) $(C_OBJS)

# Compile ASM files
$(OUTPUT_DIR)/src/asm/%.obj: src/asm/%.src Makefile.test
	@mkdir -p $(@D)
	wibo "$(SHC_BIN)/asmsh.exe" "$(subst /,\\,$<)" -object="$(subst /,\\,$@)" $(ASMSH_FLAGS)

# Compile C files
$(OUTPUT_DIR)/src/%.obj: src/%.c $(BUILD_DIR)/shc_testing.sub Makefile.test
	@mkdir -p $(@D)
	wibo "$(SHC_BIN)/shc.exe" "$(subst /,\\,$<)" -object="$(subst /,\\,$@)" -sub=$(BUILD_DIR)/shc_testing.sub
	wibo "$(SHC_BIN)/shc.exe" "$(subst /,\\,$<)" -code=asm -object="$(subst /,\\,$@).src" -sub=$(BUILD_DIR)/shc_testing.sub

clean:
	rm -rf $(OUTPUT_DIR)

rebuild: clean .WAIT all

.PHONY: all clean rebuild FORCE

include Makefile.d
